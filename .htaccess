# Serve index.html as the homepage
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send /index.html (and /index.php) to the bare domain, once, permanently.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/index\.(html|php)[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Strip the extension from any other page the visitor typed with one.
  # Only for plain GET page loads: redirecting a POST turns it into a GET and
  # throws away the body, which would silently break every API call.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.(html|php)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Admin form posts to a clean path
  RewriteRule ^admin/update-order/?$ admin/update_order.php [L]

  # Then serve the real file behind the clean URL.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# Block direct web access to config files (they hold API keys).
# Wrapped in IfModule so an older Apache can't 500 on the syntax.
<FilesMatch "^(config\.php|config\.example\.php|\.cpanel\.yml|\.gitignore|\.env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block schema/readme/database files if they ever land in public_html
<FilesMatch "\.(sql|md|db|yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Stop directory listings
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
