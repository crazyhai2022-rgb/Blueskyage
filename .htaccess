# Serve index.html as the homepage
DirectoryIndex index.html index.php

# Block direct web access to config files (they hold API keys).
# Wrapped in IfModule so an older Apache can't 500 on the syntax.
<FilesMatch "^(config\.php|config\.example\.php|\.cpanel\.yml|\.gitignore|\.env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block schema/readme/database files if they ever land in public_html
<FilesMatch "\.(sql|md|db|yml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Stop directory listings
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
